## TESTING REQUIREMENTS

### Required Tests for Every Feature

```php
// 1. Feature Test - End-to-end workflow
// tests/Feature/OrderManagementTest.php
public function test_user_can_create_order_with_articles(): void
{
    $user = User::factory()->create();
    $client = Client::factory()->create();
    
    $this->actingAs($user)
        ->post('/admin/orders', [
            'number' => 'ORD-001',
            'client_id' => $client->id,
            // ...
        ])
        ->assertRedirect();
    
    $this->assertDatabaseHas('orders', ['number' => 'ORD-001']);
}

// 2. Unit Test - Business logic
// tests/Unit/OrderCalculationTest.php
public function test_calculates_montage_time_from_articles(): void
{
    $order = Order::factory()->create();
    $article = Article::factory()->create();
    
    $order->articles()->attach($article, [
        'quantity' => 2,
        'montage_time' => 3.5,
    ]);
    
    $this->assertEquals(7.0, $order->montage_time);
}

// 3. Tenant Isolation Test - MANDATORY for all data access
// tests/Feature/TenantIsolationTest.php
public function test_orders_are_isolated_between_tenants(): void
{
    $tenant1 = Tenant::factory()->create();
    $tenant2 = Tenant::factory()->create();
    
    tenancy()->initialize($tenant1);
    $order1 = Order::factory()->create();
    
    tenancy()->initialize($tenant2);
    $this->assertEquals(0, Order::count());
    $this->assertDatabaseMissing('orders', ['id' => $order1->id]);
}
```

