### Use Model Observers for Complex Logic
```php
// ✅ CORRECT - Extract complex boot logic to observers
// app/Observers/OrderObserver.php
class OrderObserver
{
    public function creating(Order $order): void
    {
        if (!$order->number) {
            $order->number = Order::max('number') + 1;
        }
        
        if (!$order->user_id) {
            $order->user_id = auth()->id();
        }
    }
    
    public function updated(Order $order): void
    {
        if ($order->wasChanged('is_finished') && $order->is_finished) {
            $this->redistributeWorkHours($order);
            $order->montages()->update(['confirmed' => true]);
        }
    }
    
    private function redistributeWorkHours(Order $order): void
    {
        // Complex logic here
    }
}

// Register in AppServiceProvider
public function boot(): void
{
    Order::observe(OrderObserver::class);
}
```

