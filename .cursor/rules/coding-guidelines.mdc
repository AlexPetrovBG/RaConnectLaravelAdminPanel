### Use Accessors for Calculated Properties
```php
// ✅ CORRECT - Use Laravel attribute casting
use Illuminate\Database\Eloquent\Casts\Attribute;

protected function montageTime(): Attribute
{
    return Attribute::make(
        get: fn () => $this->articles->sum(fn ($article) => 
            $article->pivot->quantity * $article->pivot->montage_time
        ),
    );
}

protected function debtFromCustomer(): Attribute
{
    return Attribute::make(
        get: fn () => $this->price_to_customer - $this->paidFromCustomer,
    );
}
